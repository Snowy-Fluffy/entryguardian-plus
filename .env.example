# Telegram bot token from @BotFather (privacy mode off, group member events on)
TOKEN=your_bot_token_here

# Localization: ru_RU or en_US
LOCALE=ru_RU

# Path to SQLite database. Under Docker this is set to /app/data/users.db by docker-compose.yml
# (the ./data directory is mounted); keep the default for a bare-metal run.
DB_PATH=users.db

# Directory the minigame/static files are served from (defaults to the project directory).
# DOOM_DIR=/app

# Code entry attempts before temp-block
MAX_ATTEMPTS=3

# Temp-block duration in seconds (default 15 min)
COOL_DOWN=900

# Comma-separated Telegram user IDs of bot owners.
# Owners have access to every command in every chat where the bot is present.
# Example: OWNERS=123456789,987654321
OWNERS=

# Web server bind address. 0.0.0.0 is what Docker needs (the port is published to 127.0.0.1 on
# the host by docker-compose.yml); for a bare-metal run behind nginx use 127.0.0.1 so the server
# is never reachable directly — TRUST_PROXY_HEADERS below assumes only the proxy can reach it.
WEB_HOST=0.0.0.0
# Web server port the captcha pages are served on
WEB_PORT=8080

# Base URL used to build captcha links sent to users
CAPTCHA_BASE_URL=https://yourdomain.com/captcha

# Captcha link lifetime in seconds (default 10 min). The "valid for N minutes" line in the
# bot's captcha message follows this value.
CAPTCHA_TIMEOUT=600

# Number of enemies to kill in the DOOM captcha
CAPTCHA_ENEMIES=4

# Minimum seconds the page must be open before completion is accepted
MIN_PLAY_TIME=3.0

# Minimum seconds between registered kills (prevents scripted rapid kills)
KILL_COOLDOWN=0.5

# Minimum piece placements required to complete tetris captcha (must match min targets = 3)
CAPTCHA_MIN_PIECES=3

# Minimum seconds from page load to flagpole touch (mario captcha anti-bot timing)
MARIO_MIN_PLAY_TIME=5.0

# Comma-separated list of captcha types to randomly choose from (doom, tetris, mario).
# Unknown names are ignored; an empty list means all three.
CAPTCHA_TYPES=doom,tetris,mario

# Cloudflare Turnstile keys (create a widget at https://dash.cloudflare.com/?to=/:account/turnstile).
# Optional — when set, a Turnstile browser check runs after the minigame, before Altcha.
# Leave both empty to skip this stage entirely (the flow goes straight from the minigame to Altcha).
# For local testing without a real Cloudflare-registered domain, Cloudflare publishes dummy
# always-pass test keys that work on any host including localhost:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Per-IP rate limit on the captcha web endpoints (/captcha/* and /api/captcha/*), so a script
# hitting them directly (bypassing the minigame's own pacing) can't flood them.
# RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW seconds, per IP.
RATE_LIMIT_MAX=40
RATE_LIMIT_WINDOW=10

# Trust X-Real-IP / X-Forwarded-For set by the nginx reverse proxy in front of the web server,
# instead of the raw TCP peer address (which behind any reverse proxy — and especially through
# Docker's published-port NAT — is only the proxy's/Docker's own address, not the visitor's).
# Keep this on for the standard nginx setup described below. Only turn it off if the web
# server's port is ever reachable directly, bypassing your reverse proxy.
TRUST_PROXY_HEADERS=1

# Optional: remember the IP address + User-Agent seen the FIRST time a user opens their
# captcha page, shown in /punl. Only that first record is kept (never overwritten by later
# reloads/sessions). Off by default since it stores personal data — enable only if you need it
# (e.g. to spot several accounts passing the captcha from the same IP) and are OK with the
# privacy/retention implications.
COLLECT_CAPTCHA_IPS=0

# Auto-delete the bot's service replies in groups after N seconds: errors ("user not found",
# "no permission", cooldown notices...), confirmations ("Report sent", raid on/off), /rules,
# /staff, the "channels are forbidden" notice. Punishment announcements (ban/mute/unban/unmute)
# and welcome messages are never auto-deleted. 0 = keep service replies forever. Pending
# deletions are stored in the database and survive a restart.
SERVICE_REPLY_TTL=30

# Notify every bot owner (in DM, except the one who issued it) about each new global ban —
# who was banned, by whom, from which chat, and the reason. Silent global bans (/sgban) are
# reported too: "silent" is about the chats, not the owners. 0 = off.
NOTIFY_OWNERS_GBAN=0

# Repeated-message antispam: deletes and mutes a user who posts the same text/sticker/gif/photo/
# video/video-note/voice/document/audio N times in a row within a time window. Thresholds (count,
# window, mute duration, whether to DM staff) are configurable per chat via /admin — this only
# gates whether the feature exists at all. On by default. Requires inspecting the content/media
# id of every message to detect duplicates — turn off if that's a privacy concern for your chats.
ANTISPAM_ENABLED=1
