# Telegram bot token from @BotFather (privacy mode off, group member events on)
TOKEN=your_bot_token_here

# Localization: ru_RU or en_US
LOCALE=ru_RU

# Path to SQLite database
DB_PATH=users.db

# Code entry attempts before temp-block
MAX_ATTEMPTS=3

# Temp-block duration in seconds (default 15 min)
COOL_DOWN=900

# Comma-separated Telegram user IDs of bot owners.
# Owners have access to every command in every chat where the bot is present.
# Example: OWNERS=123456789,987654321
OWNERS=

# Web server host (use 0.0.0.0 when running inside Docker)
WEB_HOST=0.0.0.0
# Web server port the captcha pages are served on
WEB_PORT=8080

# Base URL used to build captcha links sent to users
CAPTCHA_BASE_URL=https://yourdomain.com/captcha

# Captcha link lifetime in seconds (default 10 min)
CAPTCHA_TIMEOUT=600

# Number of enemies to kill in the DOOM captcha
CAPTCHA_ENEMIES=4

# Minimum seconds the page must be open before completion is accepted
MIN_PLAY_TIME=3.0

# Minimum seconds between registered kills (prevents scripted rapid kills)
KILL_COOLDOWN=0.5

# Minimum piece placements required to complete tetris captcha (must match min targets = 3)
CAPTCHA_MIN_PIECES=3

# Minimum seconds from page load to flagpole touch (mario captcha anti-bot timing)
MARIO_MIN_PLAY_TIME=5.0

# Comma-separated list of captcha types to randomly choose from (doom, tetris, mario)
CAPTCHA_TYPES=doom,tetris,mario

# Cloudflare Turnstile keys (create a widget at https://dash.cloudflare.com/?to=/:account/turnstile).
# Required — after the minigame, a Turnstile browser check runs before the final code is shown.
# For local testing without a real Cloudflare-registered domain, Cloudflare publishes dummy
# always-pass test keys that work on any host including localhost:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Username resolve via EXTERNAL API.
# When a target @username can't be resolved by Telegram (getChat doesn't resolve regular
# users) nor found in the local cache, the bot queries an external resolve API:
#   0 = off (no external API)
#   1 = telecrm.xyz only
#   2 = Apify (TrueFetch/telegram-profile) only — requires APIFY_TOKEN below
#   3 = both (telecrm.xyz primary, Apify fallback) — requires APIFY_TOKEN below
USERNAME_RESOLVE=0

# Apify API token, used for the Apify resolver (modes 2 and 3). Get it at https://console.apify.com
APIFY_TOKEN=
